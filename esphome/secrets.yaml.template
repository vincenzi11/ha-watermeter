# =============================================================================
# ESPHome Secrets Template
# Copy this file to secrets.yaml and fill in your values.
# NEVER commit secrets.yaml to git!
# =============================================================================

# --- Primary WiFi Network (IoT / SmartHome) ---
wifi_ssid: "YourIoTNetwork"
wifi_pswd: "YourIoTPassword"

# --- Fallback WiFi Networks (optional, remove if not needed) ---
ssid1_name: "FallbackNetwork1"
ssid1_pswd: "FallbackPassword1"

ssid2_name: "FallbackNetwork2"
ssid2_pswd: "FallbackPassword2"

ssid3_name: "FallbackNetwork3"
ssid3_pswd: "FallbackPassword3"

ssid9_name: "FallbackNetwork9"
ssid9_pswd: "FallbackPassword9"

# --- Network ---
domain: ".local"

# --- Hotspot (Fallback AP when no WiFi available) ---
hotspot_pswd: "MyHotspotPassword"

# --- OTA Update Password ---
ota_pswd: "MyOtaPassword"

# --- Home Assistant API Encryption Key ---
# Generate with: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
hakey: "your-base64-encoded-32-byte-key-here="

# --- Water Meter ID ---
# 8-digit hex ID printed on your Diehl IZAR meter (e.g. 0x24058612)
# Set to 0x00000000 to receive all meters (wildcard / scan mode)
watermeterId: "0x24058612"

# --- NTP Server (optional, local network) ---
local_sntp: "pool.ntp.org"
